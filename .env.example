# Copier ce fichier en .env, puis y mettre les vrais mots de passe.
# Le fichier .env n'est jamais commité.
MERCHANTS_DB_PASSWORD=changeme
ACCOUNTS_DB_PASSWORD=changeme

# Clé de signature des jetons de connexion, 32 caractères minimum.
# Pour en générer une : openssl rand -base64 48
JWT_SECRET=change-me-with-at-least-32-random-characters
